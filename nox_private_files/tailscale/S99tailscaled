#!/bin/sh
### BEGIN INIT INFO
# Provides:          tailscaled
# Required-Start:    $network $local_fs
# Required-Stop:     $network $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Tailscale node agent
# Description:       Starts the Tailscale VPN daemon
### END INIT INFO

# 你的 tailscaled 路径
TAILSCALED="/userdata/tailscale/tailscaled"
STATE_FILE="/userdata/tailscale/tailscaled.state"
SOCKET_FILE="/run/tailscale/tailscaled.sock"
PIDFILE="/run/tailscale/tailscaled.pid"

# 创建运行目录
mkdir -p /run/tailscale
chmod 0755 /run/tailscale

start() {
    echo "Starting tailscaled..."
    start-stop-daemon -S -b -m -p $PIDFILE -x $TAILSCALED -- \
        --state=$STATE_FILE \
        --socket=$SOCKET_FILE
}

stop() {
    echo "Stopping tailscaled..."
    start-stop-daemon -K -p $PIDFILE
    $TAILSCALED --cleanup
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        stop
        start
        ;;
    status)
        if [ -f $PIDFILE ] && kill -0 $(cat $PIDFILE) 2>/dev/null; then
            echo "tailscaled is running."
        else
            echo "tailscaled is stopped."
        fi
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0